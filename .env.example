# ---------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL=
# De publieke ("publishable") sleutel. Hoort in de browser en is alleen veilig
# zolang Row Level Security op elke tabel aanstaat.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- Google Maps
# Browsersleutel: beperk in Cloud Console op HTTP-referrer en op alleen
# Maps JavaScript API. Deze staat per definitie zichtbaar in de paginabron.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Map ID, nodig voor Advanced Markers en eigen kaartstijl.
# DEMO_MAP_ID werkt voor lokale ontwikkeling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Serversleutel: APARTE sleutel, beperkt op IP en op alleen Places API (New).
# Deze verlaat de server nooit.
GOOGLE_PLACES_SERVER_KEY=
